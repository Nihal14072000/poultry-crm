# Example same-origin Nginx site configuration for the Angular SPA and Spring Boot API.
# Adjust server_name and the deployment root for the target environment.
server {
    listen 80;
    server_name _;

    root /home/ubuntu/poultry-crm/dist/my-app/browser;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:1111/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
